<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GamebuinoAKA.App.Views.HomeView"
             x:CompileBindings="False">
    <StackPanel Margin="32" Spacing="16" HorizontalAlignment="Left" VerticalAlignment="Top">
        <TextBlock Text="Gamebuino AKA IDE" FontSize="24" FontWeight="Bold"/>
        <TextBlock Text="Version Linux (Avalonia). Gérez vos projets AKA (PlatformIO / ESP-IDF)." Foreground="#BBBBBB"/>
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
            <Button Content="📁 Mes projets" Command="{Binding GoProjectsCommand}"/>
            <Button Content="➕ Nouveau projet" Command="{Binding GoNewProjectCommand}"/>
            <Button Content="⚙ Paramètres" Command="{Binding GoSettingsCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
