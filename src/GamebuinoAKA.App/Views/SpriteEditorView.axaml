<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:GamebuinoAKA.App.Controls"
             x:Class="GamebuinoAKA.App.Views.SpriteEditorView"
             x:CompileBindings="False">
    <Grid ColumnDefinitions="250,*,300">
        <!-- Outils -->
        <ScrollViewer Grid.Column="0" Background="#16162A">
            <StackPanel Margin="12" Spacing="8">
                <TextBlock Text="Image" FontWeight="Bold"/>
                <Button Content="📂 Importer image" HorizontalAlignment="Stretch" Command="{Binding ImportImageCommand}"/>
                <Button Content="↩ Rétablir l'original" HorizontalAlignment="Stretch" Command="{Binding RevertCommand}"/>
                <TextBlock Text="{Binding Dimensions, StringFormat='Taille : {0}'}" Foreground="#AAA" FontSize="11"/>

                <TextBlock Text="Zoom" Margin="0,8,0,0"/>
                <NumericUpDown Value="{Binding Zoom}" Minimum="1" Maximum="16" Increment="1"/>

                <TextBlock Text="Planche (grille)" FontWeight="Bold" Margin="0,10,0,0"/>
                <Grid ColumnDefinitions="*,*" >
                    <StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Frame L"/><NumericUpDown Value="{Binding FrameWidth}" Minimum="1"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Frame H"/><NumericUpDown Value="{Binding FrameHeight}" Minimum="1"/></StackPanel>
                </Grid>
                <Button Content="🗂 Importer planche" HorizontalAlignment="Stretch" Command="{Binding ImportSheetCommand}"/>
                <TextBlock Text="{Binding FrameInfo}" Foreground="#AAA" FontSize="11"/>

                <TextBlock Text="Sélection" FontWeight="Bold" Margin="0,10,0,0"/>
                <CheckBox Content="Mode sélection (glisser)" IsChecked="{Binding SelectionMode}"/>
                <Button Content="✂ Rogner à la sélection" HorizontalAlignment="Stretch" Command="{Binding CropCommand}"/>

                <TextBlock Text="Réduire" FontWeight="Bold" Margin="0,10,0,0"/>
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Largeur"/><NumericUpDown Value="{Binding TargetWidth}" Minimum="1"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Hauteur"/><NumericUpDown Value="{Binding TargetHeight}" Minimum="1"/></StackPanel>
                </Grid>
                <CheckBox Content="Garder les proportions" IsChecked="{Binding KeepAspect}"/>
                <CheckBox Content="Lissage" IsChecked="{Binding Smooth}"/>
                <Button Content="⤵ Réduire à la taille cible" HorizontalAlignment="Stretch" Command="{Binding ResizeCommand}"/>

                <TextBlock Text="Transparence" FontWeight="Bold" Margin="0,10,0,0"/>
                <CheckBox Content="Utiliser la couleur-clé" IsChecked="{Binding UseTransparency}"/>
                <TextBlock Text="{Binding TransparentKeyHex, StringFormat='Clé : {0}'}" Foreground="#AAA" FontSize="11"/>

                <TextBlock Text="Conversion" FontWeight="Bold" Margin="0,10,0,0"/>
                <Button Content="⚙ Convertir (voir code)" HorizontalAlignment="Stretch" Command="{Binding ConvertCommand}"/>
                <Button Content="💾 Exporter C++" HorizontalAlignment="Stretch" Command="{Binding ExportCppCommand}"/>
                <Button Content="💾 Enregistrer projet (.gbspr)" HorizontalAlignment="Stretch" Command="{Binding SaveProjectCommand}"/>
                <Button Content="📂 Ouvrir projet" HorizontalAlignment="Stretch" Command="{Binding OpenProjectCommand}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Canvas -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="#16162A" Padding="10,6">
                <TextBlock Text="{Binding Status}" Foreground="#BBB" TextWrapping="Wrap"/>
            </Border>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#0E0E1A">
                <ctrl:PixelCanvas Source="{Binding DisplayImage}"
                                  Zoom="{Binding Zoom}"
                                  SelectionMode="{Binding SelectionMode}"
                                  Selection="{Binding Selection, Mode=TwoWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
            </ScrollViewer>
        </Grid>

        <!-- Code -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*" Background="#16162A">
            <TextBlock Grid.Row="0" Text="Code C++ (à la conversion)" FontWeight="SemiBold" Margin="10,8"/>
            <ScrollViewer Grid.Row="1">
                <TextBox Text="{Binding ExportedCode}" IsReadOnly="True" AcceptsReturn="True"
                         Background="Transparent" BorderThickness="0" FontFamily="monospace" FontSize="11" Padding="10"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
